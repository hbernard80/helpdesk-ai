# HelpDesk AI - Configuration Docker

# Base de données MySQL
DB_HOST=db
DB_NAME=helpdesk
DB_USER=helpdesk
DB_PASSWORD=change_me
DB_ROOT_PASSWORD=change_root_password

# Ollama
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Qdrant : URL interne Docker et alias de la collection documentaire
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=helpdesk_procedures

# Chemins à l'intérieur du conteneur app (index JSON : compatibilité uniquement)
PROCEDURES_DIRECTORY=/var/www/procedures
PROCEDURES_INDEX_PATH=/var/www/storage/procedures-index.json

# Application
APP_ENV=development
APP_DEBUG=true
